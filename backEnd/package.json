{
  "name": "livemock",
  "version": "1.4.0",
  "description": "LiveMock is a comprehensive tool for API development and testing, offering mock data, request proxying, and logging, to streamline workflows and track traffic.",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "start": "ts-node ./src/index.ts",
    "build": "node scripts/build.mjs",
    "prepack": "yarn workspace livemock-core build && yarn workspace front-end build && node scripts/build.mjs",
    "reset-admin": "ts-node ./src/script/resetAdmin.ts",
    "testAll": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testPathPatterns=test/"
  },
  "keywords": [
    "api",
    "mock",
    "http",
    "proxy",
    "developer",
    "tool"
  ],
  "author": "jason zhai",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alinGmail/LiveMock.git"
  },
  "bugs": {
    "url": "https://github.com/alinGmail/LiveMock/issues"
  },
  "homepage": "https://github.com/alinGmail/LiveMock#readme",
  "devDependencies": {
    "@types/express": "4.17.13",
    "@types/http-proxy": "^1.17.9",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.182",
    "@types/lokijs": "^1.5.8",
    "@types/micromatch": "^4.0.7",
    "@types/node": "^20.19.0",
    "@types/supertest": "^7.2.1",
    "@types/type-is": "^1.6.3",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "livemock-core": "workspace:*",
    "mockserver-client": "^8.0.0",
    "mockserver-node": "^8.0.0",
    "mockttp": "^4.6.3",
    "node-mocks-http": "^1.18.1",
    "nodemon": "^3.1.14",
    "prettier": "2.8.7",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.7.0",
    "tsconfig-paths": "^4.2.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.8",
    "express": "4.22.3",
    "form-data": "^4.0.6",
    "http-proxy": "^1.18.1",
    "lodash": "^4.18.1",
    "lokijs": "npm:@alin_gmail/lokijs@^1.5.13",
    "micromatch": "^4.0.5",
    "mockjs": "^1.1.0",
    "requires-port": "^1.0.0",
    "socket.io": "^4.8.4",
    "type-is": "^1.6.18"
  }
}
